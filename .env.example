# Supabase (frontend). Use the bare project URL, e.g.:
#   VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Do NOT append /rest/v1/ or any path.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "true" to enable dev-only mock data so the UI is clickable
# without a running backend. Leave empty/removed for real backend use.
VITE_MOCK=false

# Google Gemini API key for direct real-time AI features across all pages
# (AI Advisor, Resume Scanner, Skill Analyzer, Role Finder, Roadmap & AI Interviewer)
VITE_GEMINI_API_KEY=
